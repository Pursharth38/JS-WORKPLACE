// ─────────────────────────────────────────────────────────────────────────────
// FILE OWNER: DEV A. Migrations are owned by each model's owner (codebase.md).
//
// ORIGIN: written by Dev B to unblock Phases 6/7/10 while Dev A's foundation was
// on another branch, then ADOPTED WHOLESALE at the A+B merge — there was no Dev A
// version to prefer, and retyping working, spec-conformant code would have been
// waste. See MERGE-NOTES.md §1.
//
// ── P1-05 REVIEW (Dev A, 2026-07-25) ────────────────────────────────────────
// Reviewed against ARCHITECTURE.md §5 and orchestrate/data-model.md. Conforms,
// including all five Dev B additions (PasswordResetToken, the
// (userId,courseId,passed) index, Payment.invoiceNumber/updatedAt/index, and
// User.updatedAt/consentGivenAt). `ModuleProgress.lastHeartbeatAt` is present and
// correct — it is the clamp basis for Dev C's heartbeat, and ARCHITECTURE.md §5
// was the document that was wrong. That has now been corrected.
//
// ⚠️ P1-05a — REFERENTIAL ACTIONS. Eight relations declared no `onDelete`, so
// Prisma defaulted them to `Restrict`:
//
//     Enrollment.user/.course · ModuleProgress.user/.module
//     AssessmentAttempt.user/.chapter · Certificate.user · Payment.user
//
// Consequence: `db.user.delete()` THROWS for any learner who has ever watched a
// lesson. The privacy policy at /privacy commits to honouring deletion requests,
// so this will surface the first time someone exercises that right.
//
// OWNERSHIP: Certificate and Payment are Dev B's models; ModuleProgress and
// AssessmentAttempt are Dev C's. Each owner decides and migrates their own.
//
//   · Certificate — DECIDED (Dev B, 2026-07-26): explicit Restrict. A
//     certificate must stay verifiable; the policy retains the minimum needed
//     for that. A `/privacy` deletion request anonymizes the User row instead
//     of cascading the delete — see lib/ (Dev B's account-deletion path, when
//     built) — it must not attempt db.user.delete() while certificates exist.
//   · Payment — DECIDED (Dev B, 2026-07-26): explicit Restrict. Financial
//     records are retained for GST/tax purposes; same anonymize-not-delete
//     path applies.
//   · ModuleProgress / AssessmentAttempt — still OPEN, owned by Dev C. Almost
//     certainly Cascade (no independent value once the user is gone), but not
//     migrated here — Dev C's lane has not started and this is not Dev B's
//     model to decide or migrate.
//   · Enrollment — still OPEN, no clear owner assignment in team-division.md
//     for this specific decision. Depends on whether access history is a
//     financial record. Flagged, not decided, by this pass.
//
// Do not "fix" this in one sweep — cascading a financial record away is worse
// than the problem. Tracked as P1-05a in .claude/orchestrate/tasks.md.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── IDENTITY ────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String? // null for OAuth-only accounts. NEVER selected into a response.
  name           String // printed on the certificate — legal name
  nameLocked     Boolean   @default(false) // flips true on first certificate issue
  phone          String?
  image          String?
  role           Role      @default(LEARNER)
  // DPDP ADDITION (Dev B): timestamped evidence that the learner ticked the
  // (unticked-by-default) privacy consent box at signup. A boolean would not
  // survive an audit asking *when* consent was given.
  consentGivenAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  enrollments    Enrollment[]
  moduleProgress ModuleProgress[]
  attempts       AssessmentAttempt[]
  certificates   Certificate[]
  payments       Payment[]
}

enum Role {
  LEARNER
  ADMIN
}

// Auth.js v5 Prisma adapter models — standard schema, do not hand-roll.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// DEV B ADDITION (not in data-model.md): password reset needs its own single-use
// store. Reusing VerificationToken would let an email-verification token be
// replayed as a password-reset token, which is a full account takeover.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the emailed token — the raw token is never stored
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── COURSE STRUCTURE + CONTENT ──────────────────────────────────────────────
// CMS MIGRATION (M1a, 2026-07-26): these models were a structure-only mirror of
// Sanity ("never body copy"). Per the approved CMS-MIGRATION-PLAN.md they now
// ALSO own the content fields Sanity used to hold. `sanityId` became optional:
// rows created in the new admin have no Sanity counterpart (multiple NULLs are
// fine under a unique index), while webhook-synced rows keep upserting by it
// until cutover. All `Json` body columns hold Tiptap documents validated by
// lib/richtext.ts on every save — never raw HTML.

model Course {
  id            String  @id @default(cuid())
  sanityId      String? @unique // null ⇒ created in /admin, not synced from Sanity
  slug          String  @unique
  title         String
  priceInPaise  Int // ★ the only price authority — checkout reads this
  isPublished   Boolean @default(false)
  passThreshold Int     @default(85) // final test %

  // content (M1a additions — nullable so existing rows are untouched)
  summary          String?
  description      Json? // Tiptap doc
  learningOutcomes String[] @default([])
  courseFaqs       Json? // {question, answer}[] — plain strings, matches CourseDetail.faqs
  durationMinutes  Int?
  coverImageKey    String? // R2 object key
  seoTitle         String?
  seoDescription   String?

  enrollments Enrollment[]
  chapters    Chapter[]
}

model Chapter {
  id            String  @id @default(cuid())
  sanityId      String? @unique
  courseId      String
  order         Int
  title         String
  passThreshold Int     @default(80) // chapter assessment %
  summary       String? // M1a

  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules   Module[]
  attempts  AssessmentAttempt[]
  questions Question[]

  @@unique([courseId, order])
}

model Module {
  id              String  @id @default(cuid())
  sanityId        String? @unique
  chapterId       String
  order           Int
  title           String
  videoUid        String // Cloudflare Stream UID — NEVER emitted for a locked module
  durationSeconds Int
  isFreePreview   Boolean @default(false)
  notes           Json? // M1a — Tiptap doc, learner-facing module notes

  chapter  Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress ModuleProgress[]

  @@unique([chapterId, order])
}

// Assessment question pool (M5). Content lives here once migrated off Sanity.
// ★ `options` is `{id, text, isCorrect}[]`. isCorrect NEVER reaches any client
//   payload — not the learner's /api/assessment/start, and not the admin list
//   endpoints either (the admin edit form is server-rendered).
model Question {
  id          String   @id @default(cuid())
  sanityId    String?  @unique
  chapterId   String
  text        String
  options     Json // {id, text, isCorrect}[]
  topic       String // drives the weak-topics feedback in /assessment/submit
  explanation String?
  isActive    Boolean  @default(true) // retired questions stop being drawn without deleting attempts' history
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, isActive])
}

// ── SITE CONTENT (CMS migration M1a) ────────────────────────────────────────
// Postgres-owned replacements for the Sanity document types. Each keeps a
// nullable unique `sanityId` so the one-time migration script can upsert
// idempotently and a re-run cannot duplicate rows.

model BlogCategory {
  id          String   @id @default(cuid())
  sanityId    String?  @unique
  title       String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  posts BlogPost[]
}

model BlogPost {
  id                String    @id @default(cuid())
  sanityId          String?   @unique
  title             String
  slug              String    @unique
  excerpt           String
  body              Json // Tiptap doc
  coverImageKey     String? // R2 object key
  coverImageAlt     String?
  categoryId        String?
  tags              String[]  @default([])
  relatedHubAnchors String[]  @default([]) // anchors into /posh-act
  seoTitle          String?
  seoDescription    String?
  isPublished       Boolean   @default(false)
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
}

model Service {
  id             String   @id @default(cuid())
  sanityId       String?  @unique
  title          String
  slug           String   @unique
  summary        String
  order          Int      @default(0)
  icon           String?
  whoItIsFor     String[] @default([])
  whatIsCovered  String[] @default([])
  format         String?
  body           Json? // Tiptap doc
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, order])
}

model PoshSection {
  id          String   @id @default(cuid())
  sanityId    String?  @unique
  title       String
  // ⚠️ Anchors are PERMANENT public deep links (/posh-act#<anchor>) shared in
  // trainings and emails. The admin UI warns loudly before letting one change.
  anchor      String   @unique
  group       String
  order       Int      @default(0)
  summary     String?
  isFaq       Boolean  @default(false)
  body        Json // Tiptap doc
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group, order])
}

model QuickReference {
  id          String   @id @default(cuid())
  sanityId    String?  @unique
  title       String
  anchor      String   @unique
  order       Int      @default(0)
  intro       String?
  body        Json // Tiptap doc
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id          String   @id @default(cuid())
  sanityId    String?  @unique
  question    String
  answer      Json // Tiptap doc
  category    String
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, order])
}

model Testimonial {
  id            String   @id @default(cuid())
  sanityId      String?  @unique
  quote         String
  authorName    String
  authorRole    String?
  organization  String?
  // No default on purpose: whoever inserts a row must state explicitly whether
  // written permission is on file. Public getters filter on it; the admin form
  // makes it a hard-required checkbox. Same rule as the Sanity schema had.
  consentOnFile Boolean
  order         Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model InstagramPost {
  id          String   @id @default(cuid())
  sanityId    String?  @unique
  imageKey    String // R2 object key
  imageAlt    String?
  permalink   String
  caption     String
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CtaBand {
  id          String   @id @default(cuid())
  sanityId    String?  @unique
  heading     String
  body        String?
  buttonLabel String
  buttonHref  String
  afterGroup  String? // which /posh-act group this band renders after
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton: id is always "singleton" — the upsert in the admin action pins it,
// mirroring Sanity Studio's singleton-pin trick at the database level.
model SiteSettingsRow {
  id                     String   @id @default("singleton")
  businessName           String   @default("JS Workplace Wellness")
  email                  String   @default("")
  phone                  String?
  whatsappNumber         String?
  whatsappDefaultMessage String?
  addressLines           String[] @default([])
  linkedinUrl            String?
  instagramUrl           String?
  youtubeUrl             String?
  announcementEnabled    Boolean  @default(false)
  announcementText       String?
  announcementHref       String?
  heroHeading            String?
  heroSubheading         String?
  heroPrimaryCtaLabel    String?
  heroPrimaryCtaHref     String?
  legalEntityName        String?
  gstin                  String?
  supportEmail           String?
  updatedAt              DateTime @updatedAt
}

// ── STATE ───────────────────────────────────────────────────────────────────

// Kept as a join table on purpose: a future B2B layer (Organization → Seat →
// Enrollment) bolts on without migrating learner data. Do not collapse into User.
model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  paymentId   String?   @unique
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model ModuleProgress {
  id              String    @id @default(cuid())
  userId          String
  moduleId        String
  secondsWatched  Int       @default(0) // cumulative, SERVER-CLAMPED
  lastPositionSec Int       @default(0) // resume point
  lastHeartbeatAt DateTime? // clamp basis for the next delta
  completedAt     DateTime? // set at secondsWatched ≥ 0.9 × durationSeconds

  user   User   @relation(fields: [userId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
}

model AssessmentAttempt {
  id           String    @id @default(cuid())
  userId       String
  chapterId    String? // null ⇒ final test
  courseId     String // denormalized for the final-test query
  scorePercent Int
  passed       Boolean
  answers      Json // { questionId: selectedOptionId }
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?

  user    User     @relation(fields: [userId], references: [id])
  chapter Chapter? @relation(fields: [chapterId], references: [id])

  @@index([userId, chapterId])
  // DEV B ADDITION: the H5 eligibility read in /api/certificate/issue filters on
  // (userId, courseId, chapterId IS NULL, passed). Without this it is a seq scan.
  @@index([userId, courseId, passed])
}

model Certificate {
  id           String    @id @default(cuid())
  certId       String    @unique // JSWW-2026-A7K2P9 — human-readable, non-sequential
  userId       String
  courseId     String
  learnerName  String // snapshot at issue time — NOT a live join
  issuedAt     DateTime  @default(now())
  pdfUrl       String
  revokedAt    DateTime?
  revokeReason String?

  // P1-05a (Dev B decision, 2026-07-26): explicit Restrict. A certificate must
  // stay verifiable after a `/privacy` deletion request, so the account delete
  // is what must be blocked/handled (e.g. anonymize User, keep Certificate),
  // never a silent cascade that deletes proof a course was completed.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Idempotency is enforced by a PARTIAL unique index that Prisma cannot express
  // in schema syntax. It is created by raw SQL in the migration:
  //   CREATE UNIQUE INDEX cert_active_unique
  //     ON "Certificate"("userId","courseId") WHERE "revokedAt" IS NULL;
  @@index([userId, courseId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  courseId          String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique // set by the webhook
  amountInPaise     Int // copied from Course at order creation
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  invoiceUrl        String?
  invoiceNumber     String?       @unique // DEV B ADDITION: sequential-per-FY GST invoice number
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // P1-05a (Dev B decision, 2026-07-26): explicit Restrict. Financial records
  // are retained for tax purposes (GST); a deletion request must anonymize the
  // User, not cascade away the Payment row.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// DEV B ADDITION: GST invoice numbers must be sequential within an Indian
// financial year (1 April – 31 March). Deriving the number from `count(*)` is
// not safe under concurrency — two simultaneous payments both read the same
// count and mint the same number. This row is incremented atomically instead.
model InvoiceCounter {
  financialYear String   @id // "2026-27"
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Lead {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  organization    String?
  employeeCount   String?
  serviceInterest String?
  message         String?
  source          String // 'demo'|'checklist'|'assessment'|'newsletter'
  consentGiven    Boolean // DPDP — must come from an UNTICKED checkbox
  createdAt       DateTime @default(now())

  @@index([source, createdAt])
}
