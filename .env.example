# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sanity ───────────────────────────────────────────────────────────
# OPTIONAL FOR LOCAL DEV. With PROJECT_ID unset, every Sanity read returns empty
# and the site renders its shell with empty-state copy — deliberate, so the app
# builds and runs before the client's Sanity project exists. Set it to see real
# content or to use /studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Set to "true" to preview the DESIGN against demo/placeholder content on
# localhost, even with a real, seeded Sanity project connected above (this is
# how you check what a change looks like without touching real content, or
# without needing to blank out PROJECT_ID — which would also disable /studio).
# Never set this in production.
NEXT_PUBLIC_FORCE_DEMO=
# Pinned date, not "latest" — a silently shifting GROQ version is a content bug
# that surfaces weeks after the deploy that caused it.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01
SANITY_API_READ_TOKEN=
# Shared secret for /api/webhooks/sanity. Set the SAME value in the Sanity
# dashboard webhook as an `x-sanity-webhook-secret` header. Without it the route
# returns 500 and structure never syncs into Postgres.
SANITY_WEBHOOK_SECRET=

# SEED SCRIPT ONLY — `npm run seed:sanity`. Sanity dashboard → API → Tokens,
# permission "Editor". The running app never reads this; it is not needed in
# production and should not be set on Vercel.
# ⚠️ NEVER prefix this with NEXT_PUBLIC_ — that would ship a write token to every
#    visitor's browser and hand them your entire CMS.
SANITY_API_WRITE_TOKEN=

# ── Cloudflare (Stream + R2) ─────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Razorpay (test keys until legal pages are live) ───────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID. The browser needs the key id to open Checkout;
# only KEY_SECRET and WEBHOOK_SECRET are secret. Never NEXT_PUBLIC_ those two.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, or delivery silently fails.
EMAIL_FROM="JS Workplace Wellness <noreply@jsworkplacewellness.com>"

# ── Invoicing (Dev B) ─────────────────────────────────────────────────
# Leave SELLER_GSTIN EMPTY until P0-05 confirms GST registration. When empty the
# invoice renders with no GSTIN line and no tax breakdown — which is correct for
# an unregistered seller. Never fill it with a placeholder.
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_EMAIL=

# ── Rate limiting ────────────────────────────────────────────────────
# OPTIONAL. Leave both empty (recommended): lib/ratelimit.ts then uses a
# zero-cost in-memory sliding window, which is enough for this project's
# hardening needs. Fill these ONLY if exact global limits across serverless
# instances become necessary — Upstash then takes over automatically, but note
# its free tier is 10k commands/day and every rate-limited request spends some.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Bot protection (Dev A) ───────────────────────────────────────────
# OPTIONAL. With TURNSTILE_SECRET_KEY unset, lib/turnstile.ts skips verification
# and logs a warning, so forms work locally and in CI without a Cloudflare
# account. The honeypot and the rate limiter still apply.
# ⚠️ MUST be set before launch — otherwise every public form is bot-open.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Lead magnet (Dev A) ──────────────────────────────────────────────
# OPTIONAL. Signs the expiring checklist download links. Falls back to
# NEXTAUTH_SECRET when unset, which is fine — set it only if you want the
# checklist links to survive a NEXTAUTH_SECRET rotation.
LEAD_MAGNET_SECRET=

# ── YouTube (Dev C, Phase 11) ────────────────────────────────────────
# OPTIONAL. With either unset, /api/youtube/latest returns an empty list and
# the home page's YouTube strip renders nothing — same degrade-to-empty
# pattern as an unconfigured Sanity project. Data API v3, "channels.list" quota
# cost only (1 unit) plus "search.list" (100 units) per cache-miss fetch; cached
# 6h via Next's fetch cache, so real-world quota use is a handful of units/day.
YOUTUBE_API_KEY=
# The channel's ID (starts "UC..."), not its @handle or custom URL — Data API
# v3 does not accept a handle here. Find it via the channel's "Share channel"
# dialog or a lookup tool; it does not change once set.
YOUTUBE_CHANNEL_ID=

# ⚠️ NO NEXT_PUBLIC_WHATSAPP_NUMBER — REMOVED DELIBERATELY.
# The WhatsApp number, phone, email and address all live in Sanity
# `siteSettings`, so the client can change them herself without a developer or a
# redeploy. platform-agent.md treats a hardcoded contact detail as a review
# failure. An env var is just a slower hardcode. Do not reintroduce this.
