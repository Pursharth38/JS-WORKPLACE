# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sanity ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging
SANITY_API_READ_TOKEN=
SANITY_WEBHOOK_SECRET=

# ── Cloudflare (Stream + R2) ─────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Razorpay (test keys until legal pages are live) ───────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID. The browser needs the key id to open Checkout;
# only KEY_SECRET and WEBHOOK_SECRET are secret. Never NEXT_PUBLIC_ those two.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, or delivery silently fails.
EMAIL_FROM="JS Workplace Wellness <noreply@jsworkplacewellness.com>"

# ── Invoicing (Dev B) ─────────────────────────────────────────────────
# Leave SELLER_GSTIN EMPTY until P0-05 confirms GST registration. When empty the
# invoice renders with no GSTIN line and no tax breakdown — which is correct for
# an unregistered seller. Never fill it with a placeholder.
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_EMAIL=

# ── Rate limiting ────────────────────────────────────────────────────
# OPTIONAL. Leave both empty (recommended): lib/ratelimit.ts then uses a
# zero-cost in-memory sliding window, which is enough for this project's
# hardening needs. Fill these ONLY if exact global limits across serverless
# instances become necessary — Upstash then takes over automatically, but note
# its free tier is 10k commands/day and every rate-limited request spends some.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Misc ─────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=
